{
  "extends": "@tsconfig/node20/tsconfig.json",
  "include": ["build/**/*.ts", "utils/**/*.ts", "eslint.config.js"],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "target": "es2022",
    "lib": ["es2022"]
  }
}