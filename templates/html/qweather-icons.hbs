<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>qweather-icons</title>
    <style>
        .icons {
            display: grid;
            max-width: 100%;
            grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
            gap: 1.25rem;
        }

        .icon {
            background-color: transparent;
            border-radius: .25rem;
            font-size: 1.5rem;
            text-align: center;
        }

        .label {
            display: inline-block;
            width: 100%;
            overflow: hidden;
            font-size: .625rem;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
    </style>
    <link href="./{{fontName}}.css" rel="stylesheet">
</head>
<body class="text-center">
<h1>{{fontName}}</h1>
<div class="icons">
    {{#each iconsList}}
        <div class="icon">
            <i class="{{className}}"></i>
            <div class="label">{{label}}</div>
        </div>
    {{/each}}
</div>
<div class="icons">
    {{#each iconsList}}
        <div class="icon">
            <i class="{{../fontName}}">{{code}}</i>
            <div class="label">{{label}}</div>
        </div>
    {{/each}}
</div>
<div class="icons">
    {{#each iconsList}}
        <div class="icon">
            <i class="{{../fontName}}">&#x{{unicode}}</i>
            <div class="label">{{label}}</div>
        </div>
    {{/each}}
</div>
</body>
</html>
